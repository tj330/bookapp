groups:
  - name: Service availability
    rules:
    - alert: MetadataServiceDown
      expr: up{service="metadata"} == 0
      labels:
        severity: warning
      annotations:
        title: "Metadata service is down"
        description: "Failed to scrape {{ $labels.service }} service on {{ $labels.instance }}. Service possibly down."
    - alert: RatingServiceDown
      expr: up{service="rating"} == 0
      labels:
        severity: warning
      annotations:
        title: "Rating service is down"
        description: "Failed to scrape {{ $labels.service }} service on {{ $labels.instance }}. Service possibly down."
    - alert: BookServiceDown
      expr: up{service="book"} == 0
      labels:
        severity: warning
      annotations:
        title: "Book service is down"
        description: "Failed to scrape {{ $labels.service }} service on {{ $labels.instance }}. Service possibly down."
    - alert: AuthServiceDown
      expr: up{service="auth"} == 0
      labels:
        severity: warning
      annotations:
        title: "Auth service is down"
        description: "Failed to scrape {{ $labels.service }} service on {{ $labels.instance }}. Service possibly down."

